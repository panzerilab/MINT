# ===== MATLAB =====
# Compiled MEX binaries (built by BuildMINT.m)
*.mex*
*.oct

# MATLAB autosave / temp files
*.asv
*.m~
*.autosave

# Simulink/MATLAB cache and code-gen artifacts
slprj/
sccprj/
codegen/
*.slxc

# MATLAB Java/preferences
java.opts
octave-workspace

# MATLAB packaged toolbox / app files (build outputs, not source)
*.mltbx
*.mlappinstall

# Startup files generated by BuildMINT.m in the user's home folder
StartupMINT.m

